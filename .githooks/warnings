#!/usr/bin/env python3
"""Reports Godot's GDScript warnings (as the editor shows them) via its LSP.

Usage: .githooks/warnings [files...] (default: every tracked .gd outside
addons/). Exits 1 if there are any warnings or errors.
"""
import json
import pathlib
import socket
import subprocess
import sys
import time

PORT = 6011
root = pathlib.Path(
    subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True)
    .strip()
)
files = sys.argv[1:] or subprocess.check_output(
    ["git", "ls-files", "*.gd", ":!addons/", ":!prototypes/"], cwd=root, text=True
).split()
editor = subprocess.Popen(
    ["godot", "--headless", "--editor", "--lsp-port", str(PORT),
     "--path", str(root)],
    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
)
buffer = b""


def send(sock, message):
    body = json.dumps(message).encode()
    sock.sendall(b"Content-Length: %d\r\n\r\n" % len(body) + body)


def receive(sock, timeout):
    global buffer
    sock.settimeout(timeout)
    messages = []
    try:
        while True:
            while b"\r\n\r\n" in buffer:
                header, rest = buffer.split(b"\r\n\r\n", 1)
                length = int(header.split(b":")[-1])
                if len(rest) < length:
                    break
                messages.append(json.loads(rest[:length]))
                buffer = rest[length:]
            buffer += sock.recv(65536)
    except socket.timeout:
        pass
    return messages


try:
    for _ in range(120):
        try:
            sock = socket.create_connection(("127.0.0.1", PORT))
            break
        except OSError:
            time.sleep(0.5)
    else:
        sys.exit("Godot's language server didn't start")
    send(sock, {"jsonrpc": "2.0", "id": 1, "method": "initialize",
                "params": {"processId": None, "rootUri": root.as_uri(),
                           "capabilities": {}}})
    receive(sock, 3)
    send(sock, {"jsonrpc": "2.0", "method": "initialized", "params": {}})
    for name in files:
        path = (root / name).resolve()
        send(sock, {"jsonrpc": "2.0", "method": "textDocument/didOpen",
                    "params": {"textDocument": {
                        "uri": path.as_uri(), "languageId": "gdscript",
                        "version": 1, "text": path.read_text()}}})
    found = 0
    for message in receive(sock, 6):
        if message.get("method") != "textDocument/publishDiagnostics":
            continue
        uri = message["params"]["uri"]
        relative = pathlib.Path(uri.removeprefix("file://")).relative_to(root)
        for diagnostic in message["params"]["diagnostics"]:
            found += 1
            line = diagnostic["range"]["start"]["line"] + 1
            print(f"{relative}:{line}: {diagnostic['message']}")
    sys.exit(1 if found else 0)
finally:
    editor.kill()
