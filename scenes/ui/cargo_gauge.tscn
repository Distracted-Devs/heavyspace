[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/cargo_gauge.gd" id="1_cargo_gauge"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
draw_center = false

[node name="CargoGauge" type="CanvasLayer" node_paths=PackedStringArray("panel", "title", "bar")]
script = ExtResource("1_cargo_gauge")
panel = NodePath("Panel")
title = NodePath("Panel/Rows/Title")
bar = NodePath("Panel/Rows/Bar")

[node name="Panel" type="PanelContainer" parent="."]
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Rows" type="VBoxContainer" parent="Panel"]
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="Panel/Rows"]
theme_override_colors/font_color = Color(0.95, 0.7, 0.15, 0.8)
text = "CARGO"

[node name="Bar" type="Control" parent="Panel/Rows"]
mouse_filter = 2
