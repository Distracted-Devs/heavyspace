[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/warp_prompt.gd" id="1_prompt"]
[ext_resource type="Theme" path="res://resources/ui/holo_theme.tres" id="2_theme"]
[ext_resource type="Script" path="res://scripts/ui/input_prompt.gd" id="3_input_prompt"]
[ext_resource type="Script" path="res://scripts/effects/pulse_effect.gd" id="4_pulse"]

[node name="WarpPrompt" type="CanvasLayer"]
layer = 12
script = ExtResource("1_prompt")

[node name="Stack" type="VBoxContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("2_theme")
alignment = 2

[node name="Centre" type="CenterContainer" parent="Stack"]
layout_mode = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Stack/Centre"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"HoloCallout"

[node name="Rows" type="VBoxContainer" parent="Stack/Centre/Panel"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Quota" type="Label" parent="Stack/Centre/Panel/Rows"]
layout_mode = 2
theme_type_variation = &"HoloGold"
theme_override_font_sizes/font_size = 14
text = "QUOTA MET"
horizontal_alignment = 1

[node name="Warp" type="HBoxContainer" parent="Stack/Centre/Panel/Rows"]
layout_mode = 2
mouse_filter = 2
alignment = 1
theme_override_constants/separation = 8
script = ExtResource("3_input_prompt")
actions = Array[StringName]([&"warp_out"])
text = "WARP OUT >>"
icon_size = 40.0
label_type = &"HoloMagentaPrompt"

[node name="BottomMargin" type="Control" parent="Stack"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
mouse_filter = 2

[node name="Pulse" type="Node" parent="." node_paths=PackedStringArray("target")]
script = ExtResource("4_pulse")
target = NodePath("../Stack/Centre/Panel")
