[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/shop_overlay.gd" id="1_shop"]
[ext_resource type="Script" path="res://scripts/ui/shop_camera.gd" id="2_camera"]
[ext_resource type="Environment" path="res://resources/environments/space.tres" id="3_space"]
[ext_resource type="Shader" path="res://resources/shaders/holo_scanlines.gdshader" id="4_scanlines"]
[ext_resource type="Theme" path="res://resources/ui/holo_theme.tres" id="5_theme"]
[ext_resource type="Script" path="res://scripts/ui/input_prompt.gd" id="6_prompt"]
[ext_resource type="Script" path="res://scripts/ui/button_prompt_icon.gd" id="7_button_icon"]
[ext_resource type="Script" path="res://scripts/ui/shop_guide.gd" id="8_guide"]
[ext_resource type="Script" path="res://scripts/effects/bounce_effect.gd" id="9_bounce"]
[ext_resource type="Script" path="res://scripts/effects/pulse_effect.gd" id="10_pulse"]

[sub_resource type="SystemFont" id="SystemFont_mono"]
font_names = PackedStringArray("Menlo", "Consolas", "DejaVu Sans Mono", "monospace")

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
content_margin_left = 14.0
content_margin_top = 14.0
content_margin_right = 14.0
content_margin_bottom = 14.0
bg_color = Color(0, 0.04, 0.07, 0.75)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.3, 0.9, 1, 0.6)

[sub_resource type="ShaderMaterial" id="ShaderMaterial_scanlines"]
shader = ExtResource("4_scanlines")

[node name="ShopOverlay" type="CanvasLayer" node_paths=PackedStringArray("camera", "view", "tree_area", "level_label", "bank_label", "warp_button", "sky_camera")]
process_mode = 3
layer = 30
script = ExtResource("1_shop")
camera = NodePath("ShopCamera")
view = NodePath("View")
tree_area = NodePath("View/Tree")
level_label = NodePath("Header/Rows/LevelLabel")
bank_label = NodePath("Header/Rows/BankLabel")
warp_button = NodePath("Hints/Row/WarpButton")
sky_camera = NodePath("Sky/SkyViewport/SkyCamera")

[node name="ShopCamera" type="Node" parent="."]
script = ExtResource("2_camera")

[node name="Sky" type="SubViewportContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
stretch = true

[node name="SkyViewport" type="SubViewport" parent="Sky"]
own_world_3d = true
handle_input_locally = false
size = Vector2i(1152, 648)
render_target_update_mode = 4

[node name="WorldEnvironment" type="WorldEnvironment" parent="Sky/SkyViewport"]
environment = ExtResource("3_space")

[node name="SkyCamera" type="Camera3D" parent="Sky/SkyViewport"]
fov = 70.0

[node name="View" type="Control" parent="."]
clip_contents = true
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Tree" type="Control" parent="View"]
layout_mode = 0
mouse_filter = 2

[node name="Header" type="PanelContainer" parent="."]
offset_left = 28.0
offset_top = 24.0
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Rows" type="VBoxContainer" parent="Header"]
layout_mode = 2
mouse_filter = 2

[node name="Title" type="Label" parent="Header/Rows"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.3, 0.8, 1)
theme_override_fonts/font = SubResource("SystemFont_mono")
theme_override_font_sizes/font_size = 40
text = "SHOP"

[node name="LevelLabel" type="Label" parent="Header/Rows"]
layout_mode = 2
theme_override_colors/font_color = Color(0.3, 0.9, 1, 1)
theme_override_fonts/font = SubResource("SystemFont_mono")
theme_override_font_sizes/font_size = 22

[node name="BankLabel" type="Label" parent="Header/Rows"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.88, 0.3, 1)
theme_override_fonts/font = SubResource("SystemFont_mono")
theme_override_font_sizes/font_size = 22

[node name="Hints" type="PanelContainer" parent="."]
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_top = -24.0
offset_bottom = -24.0
grow_horizontal = 2
grow_vertical = 0
mouse_filter = 2
theme = ExtResource("5_theme")
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Row" type="HBoxContainer" parent="Hints"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 28

[node name="Move" type="HBoxContainer" parent="Hints/Row"]
layout_mode = 2
mouse_filter = 2
script = ExtResource("6_prompt")
actions = Array[StringName]([&"ui_up", &"ui_left", &"ui_down", &"ui_right"])
text = "MOVE"
icon_size = 26.0
label_type = &"HoloHint"

[node name="Buy" type="HBoxContainer" parent="Hints/Row"]
layout_mode = 2
mouse_filter = 2
script = ExtResource("6_prompt")
actions = Array[StringName]([&"ui_accept"])
text = "BUY"
icon_size = 26.0
label_type = &"HoloHint"

[node name="Zoom" type="HBoxContainer" parent="Hints/Row"]
layout_mode = 2
mouse_filter = 2
script = ExtResource("6_prompt")
actions = Array[StringName]([&"shop_zoom_out", &"shop_zoom_in"])
text = "ZOOM"
icon_size = 26.0
label_type = &"HoloHint"

[node name="WarpButton" type="Button" parent="Hints/Row"]
layout_mode = 2
focus_mode = 0
theme_override_colors/font_color = Color(1, 0.3, 0.8, 1)
theme_override_colors/font_hover_color = Color(1, 1, 1, 1)
theme_override_fonts/font = SubResource("SystemFont_mono")
theme_override_font_sizes/font_size = 18
theme_override_constants/icon_max_width = 26
text = " WARP IN >>"
flat = true

[node name="WarpIcon" type="Node" parent="Hints/Row/WarpButton" node_paths=PackedStringArray("button")]
script = ExtResource("7_button_icon")
button = NodePath("..")
actions = Array[StringName]([&"warp_out"])

[node name="WarpArrow" type="Label" parent="Hints/Row/WarpButton"]
visible = false
layout_mode = 0
mouse_filter = 2
theme_type_variation = &"HoloMagenta"
theme_override_font_sizes/font_size = 30
text = "▼"
horizontal_alignment = 1

[node name="BuyTag" type="VBoxContainer" parent="."]
visible = false
mouse_filter = 2
theme = ExtResource("5_theme")
theme_override_constants/separation = 0

[node name="Prompt" type="HBoxContainer" parent="BuyTag"]
layout_mode = 2
mouse_filter = 2
alignment = 1
script = ExtResource("6_prompt")
actions = Array[StringName]([&"ui_accept"])
text = "BUY"
icon_size = 28.0
label_type = &"HoloGold"

[node name="Arrow" type="Label" parent="BuyTag"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"HoloMagenta"
theme_override_font_sizes/font_size = 26
text = "▼"
horizontal_alignment = 1

[node name="ShopGuide" type="Node" parent="." node_paths=PackedStringArray("shop", "buy_tag", "buy_hint", "warp_arrow", "buy_tag_bounce", "buy_hint_pulse", "warp_pulse", "warp_arrow_bounce")]
script = ExtResource("8_guide")
shop = NodePath("..")
buy_tag = NodePath("../BuyTag")
buy_hint = NodePath("../Hints/Row/Buy")
warp_arrow = NodePath("../Hints/Row/WarpButton/WarpArrow")
buy_tag_bounce = NodePath("BuyTagBounce")
buy_hint_pulse = NodePath("BuyHintPulse")
warp_pulse = NodePath("WarpPulse")
warp_arrow_bounce = NodePath("WarpArrowBounce")

[node name="BuyTagBounce" type="Node" parent="ShopGuide" node_paths=PackedStringArray("target")]
script = ExtResource("9_bounce")
target = NodePath("../../BuyTag")
active = false

[node name="BuyHintPulse" type="Node" parent="ShopGuide" node_paths=PackedStringArray("target")]
