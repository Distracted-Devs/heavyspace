brightness = 1.8
active = false

[node name="WarpPulse" type="Node" parent="ShopGuide" node_paths=PackedStringArray("target")]
script = ExtResource("10_pulse")
target = NodePath("../../Hints/Row/WarpButton")
brightness = 1.8
active = false

[node name="WarpArrowBounce" type="Node" parent="ShopGuide" node_paths=PackedStringArray("target")]
